rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'roni.ardiansyah57@guru.smk.belajar.id' ||
        exists(/databases/$(database)/documents/admin_emails/$(request.auth.token.email)) ||
        exists(/databases/$(database)/documents/admin_emails/$(request.auth.token.email.lower()))
      );
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Public readable collections; only Admin can create, update, delete
    match /settings/{settingId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /news/{newsId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /sop/{sopId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /staff/{staffId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Admin email registry: authenticated users can read, admin can write
    match /admin_emails/{emailId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }
  }
}
